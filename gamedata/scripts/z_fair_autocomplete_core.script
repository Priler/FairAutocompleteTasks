printf("[FA] Core script loading...")

-- ### MODULE REFERENCES

local function get_mcm_config(category, key)
    if fair_autocomplete_mcm and fair_autocomplete_mcm.get_config then
        return fair_autocomplete_mcm.get_config(category, key)
    end
    local defaults = {
        enable = true,
        enable_autocomplete = true,
        pda_check = true,
        respect_fe_pda_flag = false,
        no_penalty_on_giver_death = true,
        require_player_kill = true,
        companion_kills_count = true,
        count_assists = true,
        max_kill_distance = 0,
        require_same_level = true,
        cancel_if_stolen = true,
        level_proximity_check = false,
        level_proximity_mode = 1,
        level_proximity_n = 2,
        check_interval = 2.0,
        completion_delay = 5,
        -- Task types
        assault = true,
        bounty = true,
        mutant_hunt = true,
        spring_clean = true,
        defense = false,
        hostage = false,
        spy_extract = false,
        fate = false,
        scripted = false,
        retrieve = false,
        measurements = false,
        scanner = false,
        snitch = false,
        destroy_btrs = true,
        research_hunt = false,
        recover_tracker = false,
        fetch = false,
        -- Rewards
        compensate_item_rewards = true,
        compensation_coefficient = 0.4,
        -- UI
        show_stolen_message = true,
        -- Lists
        whitelist = "",
        blacklist = "esc_2_12_stalker_wolf_task_3",
        -- Debug
        debug = false,
    }
    return defaults[key]
end

