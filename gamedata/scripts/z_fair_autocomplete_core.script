-- infer monster type from section name
local function infer_monster_type_from_section(section)
    if not section then return nil end
    
    -- first try: section starts with monster type
    for prefix, monster_type in pairs(SECTION_TO_MONSTER_TYPE) do
        if string.find(section, prefix, 1, true) == 1 then
            return monster_type
        end
    end
    
    -- second try: section contains monster type (for sections like "labx16_zombie_12", "gar_dog_5")
    for prefix, monster_type in pairs(SECTION_TO_MONSTER_TYPE) do
        if string.find(section, "_" .. prefix, 1, true) then
            return monster_type
        end
    end
    
    return nil
end

-- check if killed creature section matches required section
local function section_matches(kill_section, required_section, monster_type)
    if not required_section then return false end
    if not kill_section then return false end
    
    -- strip _day/_night suffix from monster types
    local function normalize_monster_type(mtype)
        if not mtype then return nil end
        local normalized = mtype:gsub("_day$", ""):gsub("_night$", "")
        return normalized
    end
    
    -- check if required_section is a monster category
    if string.find(required_section, "monster_", 1, true) == 1 then
        local required_normalized = normalize_monster_type(required_section)
        
        if monster_type then
            local kill_normalized = normalize_monster_type(monster_type)
            
            if kill_normalized == required_normalized then
                return true
            end
            if string.find(kill_normalized, required_normalized, 1, true) == 1 then
                return true
            end
            if string.find(required_normalized, kill_normalized, 1, true) == 1 then
                return true
            end
            return false
        end
        
        -- fallback: infer monster_type from section name
        local inferred_type = infer_monster_type_from_section(kill_section)
        if inferred_type then
            local inferred_normalized = normalize_monster_type(inferred_type)
            
            if inferred_normalized == required_normalized then
                return true
            end
            if string.find(inferred_normalized, required_normalized, 1, true) == 1 then
                return true
            end
            if string.find(required_normalized, inferred_normalized, 1, true) == 1 then
                return true
            end
        end
        
        return false
    end
    
    -- exact match
    if kill_section == required_section then return true end
    
    -- partial match: kill_section starts with required_section
    if string.find(kill_section, required_section, 1, true) == 1 then return true end
    
    return false
end

-- validators return:
--   true, "<reason>"    -> credit player, task auto-completes
--   false, "stolen_*"   -> cancel as stolen (when cancel_if_stolen enabled)
--   false, "uncertain_*" -> leave alone, no autocomplete and no cancel

local function get_target_position(target_id)
    if not target_id then return nil end
    local se_obj = alife_object(target_id)
    if not se_obj or not se_obj.position then return nil end
    -- server objects expose position as a FIELD, not a method. see ref §770.
    return se_obj.position
end

local function any_player_kill_near(tracker, pos, radius_m, window_s, monsters_only)
    if not pos or not tracker or not tracker._player_kills then return false end
    local current_time = os.time()
    local r2 = radius_m * radius_m
    for _, kill_data in pairs(tracker._player_kills) do
        if (kill_data.is_player_kill or kill_data.is_companion_kill) then
            if (not monsters_only) or kill_data.is_monster then
                local kt = kill_data.time
                if kt and type(kt) == "number" and (current_time - kt) <= window_s then
                    local kp = kill_data.position
                    if type(kp) == "table" and kp.x then
                        local dx = pos.x - kp.x
                        local dy = pos.y - kp.y
                        local dz = pos.z - kp.z
                        if dx*dx + dy*dy + dz*dz <= r2 then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

local function actor_recent_shot_near(tracker, pos, radius_m, window_ms)
    if not pos or not tracker then return false end
    local last_shot_time = tracker._last_actor_shot_time or 0
    if last_shot_time <= 0 then return false end
    if (time_global() - last_shot_time) > window_ms then return false end

    local shot_pos = tracker._last_actor_shot_pos
    if not shot_pos and db.actor and db.actor.position then
        local ok, ap = pcall(function() return db.actor:position() end)
        if ok and ap then shot_pos = { x = ap.x, y = ap.y, z = ap.z } end
    end
    if not shot_pos then return false end

    local dx = pos.x - shot_pos.x
    local dy = pos.y - shot_pos.y
    local dz = pos.z - shot_pos.z
    return dx*dx + dy*dy + dz*dz <= radius_m * radius_m
end

local function validate_bounty_kill(task_id)
    local target_id = nil

    local reg = _registered_tasks[task_id]
    if reg and reg.target_id then
        target_id = tonumber(reg.target_id) or reg.target_id
    end

    if not target_id then
        if axr_task_manager and axr_task_manager.bounties_by_id then
            target_id = axr_task_manager.bounties_by_id[task_id]
            if target_id then target_id = tonumber(target_id) or target_id end
        end
        if not target_id then
            local var = load_var(db.actor, task_id)
            if var then target_id = tonumber(var.target_id) or var.target_id end
        end
    end

    if not target_id then return false, "uncertain_no_target" end

    local tracker = get_kill_tracker()
    if not tracker then return false, "uncertain_no_tracker" end

    if tracker.was_killed_by_player_or_companion and tracker.was_killed_by_player_or_companion(target_id) then
        return true, "player_kill"
    end

    -- kill IS recorded as player/companion but the credit query said no: the
    -- only causes are the max_kill_distance / require_same_level gates or
    -- companion_kills_count off. Abstain, never cancel: the player did engage,
    -- only a gate withheld credit. Must return before the proximity fallbacks
    -- below, which ignore the gates and would re-credit the same kill.
    do
        local kt = tonumber(target_id) or target_id
        local kd = tracker._player_kills and tracker._player_kills[kt]
        if kd and (kd.is_player_kill or kd.is_companion_kill) then
            return false, "uncertain_kill_rejected"
        end
    end

    -- target_id may be a squad ID
    if tracker.was_squad_member_killed_by_player then
        local ok = tracker.was_squad_member_killed_by_player(target_id)
        if ok then return true, "squad_member_kill" end
    end

    local kt_norm = tonumber(target_id) or target_id
    local kill_data = tracker._player_kills and tracker._player_kills[kt_norm]
    local npc_kill_record = kill_data
        and not kill_data.is_player_kill and not kill_data.is_companion_kill

    if npc_kill_record then
        -- assist override for bad attribution (anomaly tick, splash, etc.)
        if tracker.was_hit_by_player_or_companion and tracker.was_hit_by_player_or_companion(kt_norm) then
            return true, "target_hit_then_died"
        end
        -- a killer attributed to a living stalker/monster is hard theft
        -- evidence: it must outrank the shot-proximity fallbacks below, or
        -- any firefight the player has within 350m masks a real theft of this target
        -- environment kills (barrel, anomaly) stay rescueable
        if kill_data.killer_attributed and kill_data.killer_id ~= kt_norm then
            return false, "stolen_someone_else_killed"
        end
    end

    local target_dead = tracker.is_target_dead and tracker.is_target_dead(target_id)
    if target_dead then
        local target_pos = get_target_position(target_id)
        if target_pos and any_player_kill_near(tracker, target_pos, 100, 60, false) then
            return true, "target_dead_nearby_kill"
        end
        if target_pos and actor_recent_shot_near(tracker, target_pos, 350, 30000) then
            return true, "target_dead_actor_shot"
        end
    end

    -- unattributed npc-kill record (engine gave no killer) that no fallback
    -- rescued: still counts as theft evidence, same as before
    if npc_kill_record then
        return false, "stolen_someone_else_killed"
    end
    return true, "assumed_player_no_record"
end

-- expl:
-- assault_task_target_functor covers both human-faction clears and mutant-squad clears
-- vanilla splits on the factions in status_functor_param
-- For a mutant clear we must count monster kills (player credit + stolen_npc_cleared evidence) instead of discarding them the way the human path does
local function assault_targets_monsters(task_id)
    local ok, params = pcall(parse_list, task_manager.task_ini, task_id, "status_functor_params")
    if not ok or type(params) ~= "table" then return false end
    for i = 1, #params do
        if is_squad_monster[params[i]] then return true end
    end
    return false
end

local function validate_assault_kill(task_id)
    local smart_name = nil
    local smart_position = nil
    local smart_id = nil

    local reg = _registered_tasks[task_id]
    if reg and reg.smart_terrain then
        smart_name = reg.smart_terrain
    end

    local var = load_var(db.actor, task_id)
    if var and var.smart_id then
        smart_id = var.smart_id
        local smart_obj = alife_object(var.smart_id)
        if smart_obj then
            if not smart_name then smart_name = smart_obj:name() end
            if smart_obj.position then smart_position = smart_obj.position end
        end
    end

    if smart_name and not smart_position and SIMBOARD then
        if SIMBOARD.smarts_by_names and SIMBOARD.smarts_by_names[smart_name] then
            local sd = SIMBOARD.smarts_by_names[smart_name]
            if sd and sd.smrt and sd.smrt.position then smart_position = sd.smrt.position end
        end
        if not smart_position and SIMBOARD.smarts then
            for _, sd in pairs(SIMBOARD.smarts) do
                if sd.smrt and sd.smrt:name() == smart_name then
                    if sd.smrt.position then smart_position = sd.smrt.position end
                    break
                end
            end
        end
    end
    if smart_id and not smart_position and SIMBOARD and SIMBOARD.smarts and SIMBOARD.smarts[smart_id] then
        local sd = SIMBOARD.smarts[smart_id]
        if sd and sd.smrt and sd.smrt.position then smart_position = sd.smrt.position end
    end

    if not smart_name and not smart_position then
        return false, "uncertain_no_smart_terrain"
    end

    local task_registered_time = get_task_registered_time(reg)
    local tracker = get_kill_tracker()
    if not tracker or not tracker._player_kills then
        return false, "uncertain_no_tracker"
    end

    local want_monster = assault_targets_monsters(task_id)

    -- 10-min pre-task grace window (player may clear before accepting)
    local kill_eligibility_cutoff = task_registered_time - 600

    local player_kills_at_location = 0
    local player_kills_nearby = 0
    local npc_kills_at_location = 0
    local npc_kills_nearby = 0

    for _, kill_data in pairs(tracker._player_kills) do
        local kill_time = get_time_as_number(kill_data.time)
        if kill_time >= kill_eligibility_cutoff and (kill_data.is_monster or false) == want_monster then
            local location_match = smart_name and kill_data.location == smart_name
            local nearby_match = false
            if smart_position and kill_data.position then
                local kp = kill_data.position
                if type(kp) == "table" and kp.x then
                    local dx = smart_position.x - kp.x
                    local dy = smart_position.y - kp.y
                    local dz = smart_position.z - kp.z
                    if dx*dx + dy*dy + dz*dz <= 150 * 150 then
                        nearby_match = true
                    end
                end
            end
            if kill_data.is_player_kill or kill_data.is_companion_kill then
                if location_match then player_kills_at_location = player_kills_at_location + 1 end
                if nearby_match then player_kills_nearby = player_kills_nearby + 1 end
            elseif kill_data.is_npc_kill then
                if location_match then npc_kills_at_location = npc_kills_at_location + 1 end
                if nearby_match then npc_kills_nearby = npc_kills_nearby + 1 end
            end
        end
    end

    if get_mcm_config(nil, "debug") then
        local line = string.format(
            "[FA-Assault] task=%s monster=%s player(loc=%s near=%s) npc(loc=%s near=%s)",
            tostring(task_id), tostring(want_monster),
            tostring(player_kills_at_location), tostring(player_kills_nearby),
            tostring(npc_kills_at_location), tostring(npc_kills_nearby))
        if _last_logged_hunt[task_id] ~= line then
            _last_logged_hunt[task_id] = line
            printf("%s", line)
        end
    end

    local player_kills = math.max(player_kills_at_location, player_kills_nearby)

    if player_kills > 0 then
        return true, "kills_at_location"
    end

    -- recorded npc kills at the smart are positive theft evidence and must
    -- outrank the shot-proximity guess below, or any firefight the player
    -- has within 250m of the smart masks a real npc clear bruh
    local npc_kills = math.max(npc_kills_at_location, npc_kills_nearby)
    if npc_kills > 0 then
        return false, "stolen_npc_cleared"
    end

    if smart_position and actor_recent_shot_near(tracker, smart_position, 250, 30000) then
        return true, "actor_shot_near_smart"
    end

    return true, "assumed_smart_cleared"
end

local function validate_defense_kill(task_id)
    local smart_name = nil
    local smart_position = nil

    local reg = _registered_tasks[task_id]
    if reg and reg.smart_terrain then smart_name = reg.smart_terrain end

    local var = load_var(db.actor, task_id)
    if var and var.smart_id then
        local smart_obj = alife_object(var.smart_id)
        if smart_obj then
            if not smart_name then smart_name = smart_obj:name() end
            if smart_obj.position then smart_position = smart_obj.position end
        end
    end

    if smart_name and not smart_position and SIMBOARD then
        if SIMBOARD.smarts_by_names and SIMBOARD.smarts_by_names[smart_name] then
            local sd = SIMBOARD.smarts_by_names[smart_name]
            if sd and sd.smrt and sd.smrt.position then smart_position = sd.smrt.position end
        end
    end

    if not smart_name and not smart_position then
        return false, "uncertain_no_smart_terrain"
    end

    local task_registered_time = get_task_registered_time(reg)

    local player_faction = nil
    if db.actor then
        local se_actor = alife():actor()
        if se_actor then player_faction = se_actor:community() end
    end

    local tracker = get_kill_tracker()
    if not tracker or not tracker._player_kills then
        return false, "uncertain_no_tracker"
    end

    local enemy_kills = 0
    for _, kill_data in pairs(tracker._player_kills) do
        local kill_time = get_time_as_number(kill_data.time)
        if kill_time >= task_registered_time
           and (kill_data.is_player_kill or kill_data.is_companion_kill)
           and not kill_data.is_monster
           and kill_data.faction
        then
            local location_match = smart_name and kill_data.location == smart_name
            local nearby_match = false
            if (not location_match) and smart_position and kill_data.position then
                local kp = kill_data.position
                if type(kp) == "table" and kp.x then
                    local dx = smart_position.x - kp.x
                    local dy = smart_position.y - kp.y
                    local dz = smart_position.z - kp.z
                    if dx*dx + dy*dy + dz*dz <= 150 * 150 then nearby_match = true end
                end
            end
            if (location_match or nearby_match)
               and player_faction
               and game_relations.is_factions_enemies(kill_data.faction, player_faction)
            then
                enemy_kills = enemy_kills + 1
            end
        end
    end

    if enemy_kills > 0 then
        return true, "enemy_kills_at_location"
    end

    if smart_position and actor_recent_shot_near(tracker, smart_position, 250, 30000) then
        return true, "actor_shot_near_smart"
    end

    return false, "uncertain_no_enemy_kills"
end

-- clear-the-level hunt (mutants_in_map_target). The engine advances this task
-- from stage 0 to stage 1 once the level's monster squads are gone, then stage 1
-- just asks you to walk back to the giver. We reach this only at stage_complete
-- (stage 1), so the engine has already confirmed the level was cleared; we just
-- confirm the player/companions did the killing on that level (so squads that
-- wandered off-level or despawned in offline sim don't gift completion), then
-- complete without forcing the return trip. A live presence re-check is avoided
-- on purpose: ambient wildlife can wander back onto the level after the stage
-- advanced and would wrongly block a legitimately cleared task.
local function validate_clear_map_kill(task_id, target_level, require_kill)
    if not target_level or target_level == "" then
        return false, "uncertain_no_level"
    end

    -- stage advance already proves the clear; with kill validation off, done.
    if not require_kill then
        return true, "level_cleared"
    end

    local tracker = get_kill_tracker()
    if not tracker or not tracker._player_kills then
        return false, "uncertain_no_tracker"
    end
    local reg = _registered_tasks[task_id]
    local cutoff = get_task_registered_time(reg) - 600
    for _, kd in pairs(tracker._player_kills) do
        if kd.is_monster and (kd.is_player_kill or kd.is_companion_kill)
           and kd.victim_level == target_level then
            local kt = get_time_as_number(kd.time)
            if kt and kt >= cutoff then
                return true, "level_cleared"
            end
        end
    end

    return false, "uncertain_cleared_no_player_kill"
end

local function validate_mutant_hunt_kill(task_id)
    local tracker = get_kill_tracker()
    if not tracker or not tracker._player_kills then
        return false, "uncertain_no_tracker"
    end

    local reg = _registered_tasks[task_id]
    local target_id = reg and reg.target_id
    local smart_name = reg and reg.smart_terrain
    local smart_position = nil

    local var = load_var(db.actor, task_id)
    if var then
        if not target_id and var.target_id then target_id = var.target_id end

        if not smart_name and var.smart_id then
            local smart_obj = alife_object(var.smart_id)
            if smart_obj then
                smart_name = smart_obj:name()
                if smart_obj.position then smart_position = smart_obj.position end
            end
        end
        if not smart_name and var.smart then
            if type(var.smart) == "string" then
                smart_name = var.smart
            elseif type(var.smart) == "number" then
                local smart_obj = alife_object(var.smart)
                if smart_obj then
                    smart_name = smart_obj:name()
                    if smart_obj.position then smart_position = smart_obj.position end
                end
            end
        end
        if not smart_name and var.target_smart then smart_name = var.target_smart end
    end

    if smart_name and not smart_position
       and SIMBOARD and SIMBOARD.smarts_by_names and SIMBOARD.smarts_by_names[smart_name] then
        local sd = SIMBOARD.smarts_by_names[smart_name]
        if sd and sd.smrt and sd.smrt.position then smart_position = sd.smrt.position end
    end

    -- specific target (research_hunt, recover_tracker, hunter_kill)
    if target_id then
        local target_id_norm = tonumber(target_id) or target_id

        if tracker.was_killed_by_player_or_companion and tracker.was_killed_by_player_or_companion(target_id_norm) then
            return true, "target_killed"
        end

        -- same gate-rejected abstain as the bounty validator: recorded
        -- player/companion kill withheld by distance/level/companion gates.
        do
            local kd = tracker._player_kills[target_id_norm]
            if kd and (kd.is_player_kill or kd.is_companion_kill) then
                return false, "uncertain_kill_rejected"
            end
        end

        if tracker.was_squad_member_killed_by_player then
            local ok = tracker.was_squad_member_killed_by_player(target_id_norm)
            if ok then return true, "squad_member_killed" end
        end

        local kill_data = tracker._player_kills[target_id_norm]
        local npc_kill_record = kill_data
            and not kill_data.is_player_kill and not kill_data.is_companion_kill

        if npc_kill_record then
            if tracker.was_hit_by_player_or_companion and tracker.was_hit_by_player_or_companion(target_id_norm) then
                return true, "target_hit_then_died"
            end
            -- pack credit (duh): the tracked target is one member of a hunted pack
            -- if the player killed other members of the same squad, the last
            -- straggler dying to a random npc is not a theft (kill 2 of 3 dogs,
            -- the third runs off and something else finishes it)
            if kill_data.group_id and tracker.was_squad_member_killed_by_player
               and tracker.was_squad_member_killed_by_player(kill_data.group_id) then
                return true, "squad_sibling_killed"
            end
            -- a killer attributed to a living stalker/monster is hard theft
            -- evidence: it must outrank the shot-proximity fallbacks below,
            -- or any firefight the player has within 350m masks a real theft of this target
            -- environment kills stay rescueable
            if kill_data.killer_attributed and kill_data.killer_id ~= target_id_norm then
                return false, "stolen_someone_else_killed"
            end
        end

        local target_dead = tracker.is_target_dead and tracker.is_target_dead(target_id_norm)
        local target_pos = get_target_position(target_id_norm)
        if target_dead then
            if target_pos and any_player_kill_near(tracker, target_pos, 150, 120, true) then
                return true, "target_dead_nearby_kill"
            end
            -- catches poltergeists/controllers that don't fire monster_on_death_callback
            if target_pos and actor_recent_shot_near(tracker, target_pos, 350, 30000) then
                return true, "target_dead_actor_shot"
            end
        end

        -- unattributed npc-kill record that no fallback rescued: still theft
        if npc_kill_record then
            return false, "stolen_someone_else_killed"
        end
        return true, "assumed_player_no_record"
    end

    -- area-based mutant hunt (spring_clean etc.)
    if not smart_name and not smart_position then
        return false, "uncertain_no_location"
    end

    -- 10-min pre-task grace window; same as assault validator
    local reg = _registered_tasks[task_id]
    local task_registered_time = get_task_registered_time(reg)
    local kill_eligibility_cutoff = task_registered_time - 600
    local kills_at_location = 0
    local kills_nearby = 0
    local kills_by_type = 0
    local npc_kills_at_location = 0
    local npc_kills_nearby = 0
    local npc_kills_by_type = 0

    -- fallback for wrong-smart-resolution: match by mutant type. generic tags
    -- act as wildcard since some functors don't store the specific base type.
    local expected_base_type = reg and reg.mutant_section
    local is_wildcard_type = expected_base_type
        and (expected_base_type == "monster" or expected_base_type == "creature"
             or expected_base_type == "mutant" or expected_base_type == "any")

    local function matches_expected_type(kd)
        if is_wildcard_type then return true end
        if not expected_base_type or not kd.section then return false end
        local kill_base = string.match(kd.section, "^([^_]+)")
        return kill_base and (kill_base == expected_base_type
            or kd.monster_type == expected_base_type
            or kd.section == expected_base_type)
    end

    for _, kill_data in pairs(tracker._player_kills) do
        if kill_data.is_monster then
            local kill_time = get_time_as_number(kill_data.time)
            if kill_time >= kill_eligibility_cutoff then
                local at_loc = smart_name and kill_data.location == smart_name
                local nearby = false
                if smart_position and kill_data.position then
                    local kp = kill_data.position
                    if type(kp) == "table" and kp.x then
                        local dx = smart_position.x - kp.x
                        local dy = smart_position.y - kp.y
                        local dz = smart_position.z - kp.z
                        if dx*dx + dy*dy + dz*dz <= 150 * 150 then
                            nearby = true
                        end
                    end
                end
                local by_type = matches_expected_type(kill_data)
                if kill_data.is_player_kill or kill_data.is_companion_kill then
                    if at_loc then kills_at_location = kills_at_location + 1 end
                    if nearby then kills_nearby = kills_nearby + 1 end
                    if by_type then kills_by_type = kills_by_type + 1 end
                elseif kill_data.is_npc_kill then
                    if at_loc then npc_kills_at_location = npc_kills_at_location + 1 end
                    if nearby then npc_kills_nearby = npc_kills_nearby + 1 end
                    if by_type then npc_kills_by_type = npc_kills_by_type + 1 end
                end
            end
        end
    end

    if get_mcm_config(nil, "debug") then
        -- print only when the counts actually change, not every check cycle
        local line = string.format(
            "[FA-Hunt] task=%s smart_name=%s smart_pos=%s mutant_section=%s wildcard=%s player(at_loc=%s nearby=%s by_type=%s) npc(at_loc=%s nearby=%s by_type=%s)",
            tostring(task_id), tostring(smart_name), tostring(smart_position ~= nil),
            tostring(expected_base_type), tostring(is_wildcard_type),
            tostring(kills_at_location), tostring(kills_nearby), tostring(kills_by_type),
            tostring(npc_kills_at_location), tostring(npc_kills_nearby), tostring(npc_kills_by_type))
        if _last_logged_hunt[task_id] ~= line then
            _last_logged_hunt[task_id] = line
            printf("%s", line)
        end
    end

    if kills_at_location > 0 then return true, "kills_at_location" end
    if kills_nearby > 0 then return true, "kills_nearby" end
    if kills_by_type > 0 then return true, "kills_by_type" end

    -- recorded npc kills are positive theft evidence and must outrank the
    -- shot-proximity guess below, or any firefight the player has within
    -- 250m of the smart masks a real npc clear BRUH
    if npc_kills_at_location > 0 or npc_kills_nearby > 0 or npc_kills_by_type > 0 then
        return false, "stolen_npc_cleared"
    end

    if smart_position and actor_recent_shot_near(tracker, smart_position, 250, 60000) then
        return true, "actor_shot_near_smart"
    end

    return true, "assumed_smart_cleared"
end

-- ### AUTOCOMPLETE CHECK

local function is_in_list(list_str, task_id)
    if not list_str or list_str == "" or list_str == "none" then return false end
    for item in string.gmatch(list_str, "[^,]+") do
        item = item:match("^%s*(.-)%s*$")
        local item_task_id = item:match("^([^:]+)")
        if item_task_id and item_task_id == task_id then return true end
    end
    return false
end

-- get stage override from whitelist (e.g. "task_id:0")
local function get_whitelist_stage_override(list_str, task_id)
    if not list_str or list_str == "" or list_str == "none" then return nil end
    for item in string.gmatch(list_str, "[^,]+") do
        item = item:match("^%s*(.-)%s*$")
        local item_task_id, item_stage = item:match("^([^:]+):(%d+)$")
        if item_task_id and item_task_id == task_id and item_stage then
            return tonumber(item_stage)
        end
    end
    return nil
end

-- Backwards compat: this task shipped as a dev default whitelist entry with a
-- ":0" stage override before it had dedicated clear-the-level handling. The
-- override made it complete at the accept stage. Updated players keep that entry
-- cached in axr_options.ltx, so the new default cannot clear it. Drop that one
-- exact token from the effective whitelist and let the normal path handle it.
-- A plain "esc_2_12_stalker_fanat_task_3" (no override) is left alone - that is
-- a deliberate force-complete choice, not the legacy artifact.
local LEGACY_WHITELIST_IGNORE = "esc_2_12_stalker_fanat_task_3:0"

local function strip_legacy_whitelist(list_str)
    if not list_str or list_str == "" then return list_str end
    if not string.find(list_str, "esc_2_12_stalker_fanat_task_3", 1, true) then
        return list_str
    end
    local kept = {}
    for item in string.gmatch(list_str, "[^,]+") do
        local trimmed = item:match("^%s*(.-)%s*$")
        if trimmed ~= LEGACY_WHITELIST_IGNORE then
            kept[#kept + 1] = trimmed
        end
    end
    return table.concat(kept, ",")
end

-- Resolve and cache a task's parsed task_manager.task_ini section. Returns nil
-- for tasks that have no engine ini section, e.g. JSON tasks injected into
-- task_info by frameworks like Weird Tasks Framework. A nil result means
-- "foreign task, not ours to touch".
local function get_task_def(task_id)
    if not _task_cache[task_id] then
        local parsed = utils_data.parse_ini_section_to_array(task_manager.task_ini, task_id)
        if parsed then
            _task_cache[task_id] = parsed
            _task_cache_count = _task_cache_count + 1
        end
    end
    return _task_cache[task_id]
end

local function should_autocomplete(task_id, task_info)
    if _recently_processed[task_id] then
        return false, "recently_processed"
    end

    local stage = task_info.stage
    if not stage then return false, "no_stage" end

    -- Foreign-task guard. Bail before any blacklist/whitelist/giver/register work
    -- for tasks with no task_manager.task_ini section. Frameworks like Weird
    -- Tasks Framework inject their own CGameTasks into task_info but define them
    -- in JSON, so we have no functor or stage data for them and must never route
    -- them into a validator or mutate their state. Keep this ahead of every
    -- other check.
    local tsk = get_task_def(task_id)
    if not tsk then return false, "no_task_def" end

    if HARDCODED_BLACKLIST[task_id] then
        return false, "blacklisted"
    end
    
    -- Check MCM blacklist (never autocomplete)
    local blacklist = (_cycle_config and _cycle_config.blacklist) or get_mcm_config(nil, "blacklist")
    if is_in_list(blacklist, task_id) then
        return false, "user_blacklisted"
    end
    
    -- Check if whitelisted (will bypass type check and kill validation, but NOT stage check)
    local whitelist = (_cycle_config and _cycle_config.whitelist) or strip_legacy_whitelist(get_mcm_config(nil, "whitelist"))
    local is_whitelisted = is_in_list(whitelist, task_id)
    local whitelist_stage_override = get_whitelist_stage_override(whitelist, task_id)

    if tsk.storyline and tsk.storyline == "true" then
        return false, "storyline"
    end
    
    local target_functor = tsk.target_functor

    -- Whitelisted tasks bypass type check, others require valid functor and enabled type
    if not is_whitelisted then
        if not target_functor then return false, "no_functor" end

        if not is_task_type_enabled(target_functor, task_id) then
            return false, "type_disabled"
        end
    end

    -- Task giver death check. placed AFTER blacklist/storyline/type guards so
    -- those tasks are never routed to giverdead_cancel. Returning false here
    -- prevents autocomplete; do_autocompletion decides penalty-free cancel.
    if task_info.task_giver_id then
        local se_giver = alife_object(task_info.task_giver_id)
        if not se_giver then
            return false, "giver_not_found"
        end
        if se_giver.alive then
            local success, is_alive = pcall(function() return se_giver:alive() end)
            if success and not is_alive then
                return false, "giver_dead"
            end
        end
    end

    if not _registered_tasks[task_id] then
        register_task(task_id)
    end
    
    local stage_complete = tonumber(tsk.stage_complete)
    if not stage_complete then return false, "no_complete_stage" end
    
    local current_stage = tonumber(stage)
    if not current_stage then return false, "stage_not_number" end
    
    -- Stage normalization for specific task types
    -- Spy extraction tasks need stage-1 adjustment for completion check
    local normalized_stage_complete = stage_complete
    if target_functor == "spy_task_target_functor" then
        normalized_stage_complete = stage_complete - 1
    end
    
    -- Whitelist stage override (e.g. "task_id:0" to complete at stage 0)
    if is_whitelisted and whitelist_stage_override then
        normalized_stage_complete = whitelist_stage_override
    end
    
    if current_stage ~= normalized_stage_complete then
        return false, string.format("stage_mismatch(%d!=%d)", current_stage, normalized_stage_complete)
    end
    
    -- Whitelisted tasks bypass kill validation
    if is_whitelisted then
        return true, "whitelisted"
    end

    -- clear-the-level tasks: at stage_complete the engine has already cleared the
    -- level; confirm the player did the killing via the level-based validator
    -- (vanilla mutant-hunt validation can't resolve a whole-level target).
    if target_functor == "mutants_in_map_target" then
        local require_kill = get_mcm_config(nil, "require_player_kill")
        local valid, reason = validate_clear_map_kill(task_id, tsk.target, require_kill)
        return valid, "mutant_" .. reason
    end

    if get_mcm_config(nil, "require_player_kill") then
        local task_type = get_task_type(target_functor, task_id)
        if KILL_VALIDATION_TYPES[task_type] then
            local valid, reason, prefix
            if task_type == "bounty" then
                valid, reason = validate_bounty_kill(task_id)
                prefix = "bounty_"
            elseif task_type == "assault" then
                valid, reason = validate_assault_kill(task_id)
                prefix = "assault_"
            elseif task_type == "defense" then
                valid, reason = validate_defense_kill(task_id)
                prefix = "defense_"
            elseif task_type == "mutant_hunt" then
                valid, reason = validate_mutant_hunt_kill(task_id)
                prefix = "mutant_"
            end
            -- propagate reason on both paths; guards downstream need it
            if reason and prefix then
                return valid, prefix .. reason
            end
        end
    end

    return true, "passed"
end

-- ### POST-COMPLETION CLEANUP

local function post_completion_cleanup(task_id, target_functor)
    if not target_functor then return end
    
    -- spy extraction cleanup
    if target_functor == "spy_task_target_functor" then
        local var = load_var(db.actor, task_id)
        if not var then
            printf("[FA] post_completion_cleanup: no var for spy task %s", task_id)
            return
        end
        
        local spy_obj = var.spy_id and level.object_by_id(var.spy_id)
        if not spy_obj then
            printf("[FA] post_completion_cleanup: spy_obj is nil for task %s", task_id)
        end
        
        local se_squad = var.squad_id and alife_object(var.squad_id)
        if not se_squad then
            printf("[FA] post_completion_cleanup: se_squad is nil for task %s", task_id)
            return
        end
        
        if fair_autocomplete_utils and fair_autocomplete_utils.stop_talk_squad then
            fair_autocomplete_utils.stop_talk_squad(se_squad)
        end
        
        se_squad.scripted_target = nil
        se_squad.current_action = nil
        
        if axr_companions and axr_companions.companion_squads then
            axr_companions.companion_squads[se_squad.id] = nil
        end
        
        if spy_obj then
            pcall(function()
                xr_logic.restore_scheme_and_logic(spy_obj)
                spy_obj:disable_info_portion("npcx_is_companion")
                spy_obj:disable_info_portion("npcx_beh_cannot_dismiss")
            end)
        end
        
        local se_spy = var.spy_id and alife_object(var.spy_id)
        if se_spy then
            local sname = se_spy:name()
            pcall(function()
                se_save_var(var.spy_id, sname, "companion", nil)
                se_save_var(var.spy_id, sname, "companion_cannot_dismiss", nil) 
                se_save_var(var.spy_id, sname, "companion_cannot_teleport", nil)
            end)
        end
        
        pcall(function()
            SIMBOARD:remove_squad(se_squad)
        end)
        
        printf("[FA] Spy task cleanup complete for %s", task_id)
        return
    end
    
    -- hostage task cleanup
    if target_functor == "simulation_task_target" then
        local var = load_var(db.actor, task_id)
        if var and var.squad_id then
            local se_squad = alife_object(var.squad_id)
            if se_squad then
                if fair_autocomplete_utils and fair_autocomplete_utils.stop_talk_squad then
                    fair_autocomplete_utils.stop_talk_squad(se_squad)
                end
            end
        end
        return
    end
end

-- ### LEVEL PROXIMITY GATE

-- Adjacency transcribed from configs/ai_tweaks/simulation_objects.ltx
-- (per-level target_maps), treated as undirected. ONE non-physical link is
-- omitted: l02_garbage <-> l07_military. That sim-only shortcut would make
-- Army Warehouses 2 hops from Cordon; on the in-game world map it is not.
-- get_adj() symmetrizes the lists, so listing an edge on either side is enough.
local LEVEL_NEIGHBORS = {
    k00_marsh = { "l03_agroprom", "l01_escape", "l08_yantar" },
    k01_darkscape = { "l01_escape", "l04_darkvalley" },
    l01_escape = { "k00_marsh", "k01_darkscape", "l02_garbage", "y04_pole" },
    l02_garbage = { "l06_rostok", "l03_agroprom", "l04_darkvalley", "l01_escape" },
    l03_agroprom = { "l08_yantar", "l02_garbage", "k00_marsh", "l06_rostok", "l03u_agr_underground" },
    l04_darkvalley = { "k01_darkscape", "l02_garbage", "l07_military", "k02_trucks_cemetery", "l04u_labx18", "y04_pole" },
    l05_bar = { "l06_rostok", "l07_military", "l02_garbage", "k02_trucks_cemetery" },
    l06_rostok = { "l07_military", "l08_yantar", "l02_garbage", "l03_agroprom" },
    l07_military = { "l09_deadcity", "l10_red_forest", "l10_radar", "l04_darkvalley", "k02_trucks_cemetery" },
    l08_yantar = { "l09_deadcity", "l06_rostok", "l03_agroprom", "k00_marsh", "l08u_brainlab" },
    l09_deadcity = { "l08_yantar", "l10_limansk", "l07_military" },
    l10_limansk = { "l10_red_forest", "l09_deadcity", "l11_hospital" },
    l10_radar = { "l11_pripyat", "l10_red_forest", "l07_military", "l10u_bunker" },
    l10_red_forest = { "l10_limansk", "l07_military", "l10_radar", "jupiter" },
    l11_hospital = { "l10_limansk", "l12_stancia_2" },
    l11_pripyat = { "l12_stancia", "l10_radar", "pripyat", "jupiter" },
    l12_stancia = { "l11_pripyat", "l12_stancia_2", "zaton", "l12u_sarcofag" },
    l12u_sarcofag = { "l12u_control_monolith", "l12_stancia" },
    l12u_control_monolith = { "l12u_sarcofag", "l12_stancia_2" },
    l12_stancia_2 = { "l12_stancia", "l13_generators", "l11_hospital", "l12u_control_monolith" },
    l13_generators = { "l12_stancia_2" },
    zaton = { "l12_stancia", "jupiter" },
    jupiter = { "zaton", "jupiter_underground", "l10_red_forest", "l11_pripyat" },
    pripyat = { "l11_pripyat", "jupiter_underground", "labx8" },
    jupiter_underground = { "jupiter", "pripyat" },
    k02_trucks_cemetery = { "l05_bar", "l04_darkvalley", "l07_military" },
    y04_pole = { "l01_escape", "l04_darkvalley" },
}

-- north half of the map. anything not listed is south (rule: below Red Forest
-- is south). Red Forest itself + Radar/Limansk and beyond are north; the CoP
-- zones (Zaton/Jupiter/Pripyat-outskirts) are north; Army Warehouses and Dead
-- City are south. Unknown/custom levels default to south.
local NORTH_LEVELS = {
    l10_red_forest = true, l10_radar = true, l10u_bunker = true,
    l10_limansk = true, l11_hospital = true, l11_pripyat = true,
    l12_stancia = true, l12_stancia_2 = true, l12u_sarcofag = true,
    l12u_control_monolith = true, l13_generators = true,
    zaton = true, jupiter = true, jupiter_underground = true,
    pripyat = true, labx8 = true,
}

local _adj = nil
local function get_adj()
    if _adj then return _adj end
    _adj = {}
    local function link(a, b)
        _adj[a] = _adj[a] or {}
        _adj[b] = _adj[b] or {}
        _adj[a][b] = true
        _adj[b][a] = true
    end
    for lvl, neigh in pairs(LEVEL_NEIGHBORS) do
        for _, n in ipairs(neigh) do
            link(lvl, n)
        end
    end
    return _adj
end

-- BFS hop count between two level names. 0 = same, nil = unknown/unreachable.
local function level_distance(from_lvl, to_lvl)
    if from_lvl == to_lvl then return 0 end
    local adj = get_adj()
    if not adj[from_lvl] or not adj[to_lvl] then return nil end
    local visited = { [from_lvl] = true }
    local frontier = { from_lvl }
    local dist = 0
    while #frontier > 0 and dist < 32 do
        dist = dist + 1
        local next_frontier = {}
        for _, lvl in ipairs(frontier) do
            for n in pairs(adj[lvl]) do
                if not visited[n] then
                    if n == to_lvl then return dist end
                    visited[n] = true
                    next_frontier[#next_frontier + 1] = n
                end
            end
        end
        frontier = next_frontier
    end
    return nil
end

local function level_half(lvl)
    return NORTH_LEVELS[lvl] and "north" or "south"
end

local function se_level_name(se_obj)
    if not se_obj or not se_obj.m_game_vertex_id then return nil end
    local gg = game_graph()
    if not gg then return nil end
    local al = alife()
    if not al then return nil end
    local ok, name = pcall(function()
        local v = gg:vertex(se_obj.m_game_vertex_id)
        if not v then return nil end
        return al:level_name(v:level_id())
    end)
    if ok then return name end
    return nil
end

local function giver_level_name(giver_id)
    if not giver_id then return nil end
    local se = alife_object(giver_id)
    if not se then return nil end
    local lvl = se_level_name(se)
    if lvl then return lvl end
    -- squad giver: fall back to commander's level
    if se.commander_id then
        local ok, cid = pcall(function() return se:commander_id() end)
        if ok and cid then
            local cse = alife_object(cid)
            if cse then return se_level_name(cse) end
        end
    end
    return nil
end

-- gate the AUTOCOMPLETE path by player/giver level proximity. returns true if
-- allowed. when it can't resolve a level it returns true (bias to not blocking,
-- a false abstain just hands the task to Anomaly's natural completion). a false
-- here makes the caller abstain (uncertain_*), never cancel. see DEV_STRATEGY.
local function location_allows_autocomplete(task_info)
    if not get_mcm_config(nil, "level_proximity_check") then return true end

    local giver_id = task_info and task_info.task_giver_id
    if not giver_id then return true end

    local giver_lvl = giver_level_name(giver_id)
    if not giver_lvl then return true end

    local player_lvl = level.name()
    if not player_lvl or player_lvl == "" then return true end

    if player_lvl == giver_lvl then return true end

    local mode = tonumber(get_mcm_config(nil, "level_proximity_mode")) or 1
    if mode == 2 then
        local n = tonumber(get_mcm_config(nil, "level_proximity_n")) or 2
        local d = level_distance(giver_lvl, player_lvl)
        if not d then return true end
        return d <= n
    elseif mode == 3 then
        return level_half(giver_lvl) == level_half(player_lvl)
    end

    -- mode 1 (same level only) and levels differ
    return false
end

-- ### MAIN LOOP

local function get_cycle_config()
    if not _cycle_config then
        _cycle_config = {
            enable = get_mcm_config(nil, "enable"),
            enable_autocomplete = get_mcm_config(nil, "enable_autocomplete"),
            pda_check = get_mcm_config(nil, "pda_check"),
            respect_fe_pda_flag = get_mcm_config(nil, "respect_fe_pda_flag"),
            no_penalty_on_giver_death = get_mcm_config(nil, "no_penalty_on_giver_death"),
            debug = get_mcm_config(nil, "debug"),
            require_player_kill = get_mcm_config(nil, "require_player_kill"),
            cancel_if_stolen = get_mcm_config(nil, "cancel_if_stolen"),
            compensate_item_rewards = get_mcm_config(nil, "compensate_item_rewards"),
            completion_delay = tonumber(get_mcm_config(nil, "completion_delay")) or 5,
            whitelist = strip_legacy_whitelist(get_mcm_config(nil, "whitelist")),
            blacklist = get_mcm_config(nil, "blacklist"),
        }
    end
    return _cycle_config
end

local function fire_completion(tm, task_id, giver_id, target_functor)
    -- skip if engine no longer considers the task in-progress
    -- (manual completion / failure / Anomaly's natural transition during delay)
    if not is_task_in_progress(task_id) then
        _tasks_being_autocompleted[task_id] = nil
        unregister_task(task_id)
        return false
    end

    _recently_processed[task_id] = os.time()
    -- _tasks_being_autocompleted already set at queue time (do_autocompletion)

    pcall(function()
        post_completion_cleanup(task_id, target_functor)
        show_completion_message(task_id, giver_id)
        tm:set_task_completed(task_id)
    end)

    unregister_task(task_id)
    return true
end

local function fire_cancellation(tm, task_id, giver_id, reason)
    local giver_dead = reason == "giverdead_cancel"
    if not is_task_in_progress(task_id) then
        -- engine processed during delay; condlists already stripped
        pcall(function()
            if giver_dead then show_giver_dead_message(task_id, giver_id)
            else show_stolen_message(task_id, giver_id) end
        end)
        unregister_task(task_id)
        return false
    end

    _recently_processed[task_id] = os.time()

    pcall(function()
        -- stop any active dialog with task NPCs before cancellation (CTD prevention)
        local var = load_var(db.actor, task_id)
        if var then
            local squad_id = var.squad_id or var.target_id
            if squad_id then
                local se_squad = alife_object(squad_id)
                if se_squad and se_squad.squad_members and fair_autocomplete_utils then
                    fair_autocomplete_utils.stop_talk_squad(se_squad)
                end
            end
        end

        -- immediate-fire path (delay_ms == 0) didn't go through queue strip
        local task_info_entry = tm.task_info and tm.task_info[task_id]
        if task_info_entry then
            task_info_entry.on_fail = nil
        end

        tm:set_task_cancelled(task_id)
        if giver_dead then show_giver_dead_message(task_id, giver_id)
        else show_stolen_message(task_id, giver_id) end
    end)

    unregister_task(task_id)
    return true
end

-- GAMMA task givers gate new-task offers on the drx_sl_task_giver_<giver_id>
-- save_var (outstanding-task count). For most tasks that decrement, plus the
-- stored-task reset, lives inside on_fail/on_complete. When we cancel by
-- stripping on_fail (to drop the goodwill penalty) and the task has no separate
-- on_cancel, that cleanup is lost and the giver leaks a phantom outstanding
-- task, eventually refusing to hand out work. Run the cleanup directly here.
-- Tasks that DO define on_cancel run it via the engine's cancelled branch, so
-- skip them to avoid a double decrement. Both effects read
-- task_info[task_id].task_giver_id, so the entry must still exist when called.
local function run_drx_giver_cleanup(task_id, task_info)
    if task_info and task_info.on_cancel then return end
    if not (xr_effects and xr_effects.drx_sl_unregister_task_giver) then return end
    local p = { task_id }
    pcall(function()
        xr_effects.drx_sl_unregister_task_giver(db.actor, db.actor, p)
        xr_effects.drx_sl_reset_stored_task(db.actor, db.actor, p)
    end)
end

-- undo the queue-time condlist strip when a pending cancellation is abandoned (edge case)
local function restore_task_condlists(tm, task_id)
    local task_info = tm and tm.task_info and tm.task_info[task_id]
    if not task_info then return end
    local ini = task_manager.task_ini
    if not (ini and ini:section_exist(task_id)) then return end
    pcall(function()
        if not task_info.on_complete and ini:line_exist(task_id, "on_complete") then
            task_info.on_complete = ini:r_string_to_condlist(task_id, "on_complete")
        end
        if not task_info.on_fail and ini:line_exist(task_id, "on_fail") then
            task_info.on_fail = ini:r_string_to_condlist(task_id, "on_fail")
        end
    end)
end

local function drain_pending_queues(tm, now_ms, cfg)
    local already_queued = {}
    for task_id, entry in pairs(_pending_completions) do
        if not is_task_in_progress(task_id) then
            -- task finished some other way; drop the queue entry
            _pending_completions[task_id] = nil
        elseif not cfg.enable_autocomplete then
            -- option toggled off during the delay window or across a save
            _tasks_being_autocompleted[task_id] = nil
            _pending_completions[task_id] = nil
        elseif entry.ready_at <= now_ms then
            already_queued[task_id] = true
            fire_completion(tm, task_id, entry.giver_id, entry.target_functor)
            _pending_completions[task_id] = nil
        else
            already_queued[task_id] = true
        end
    end
    for task_id, entry in pairs(_pending_cancellations) do
        local giver_dead = entry.reason == "giverdead_cancel"
        local still_enabled = (giver_dead and cfg.no_penalty_on_giver_death)
            or (not giver_dead and cfg.cancel_if_stolen)
        if not is_task_in_progress(task_id) then
            _pending_cancellations[task_id] = nil
        elseif not still_enabled then
            -- option toggled off during the delay window or across a save
            restore_task_condlists(tm, task_id)
            _pending_cancellations[task_id] = nil
        elseif entry.ready_at <= now_ms then
            already_queued[task_id] = true
            fire_cancellation(tm, task_id, entry.giver_id, entry.reason)
            _pending_cancellations[task_id] = nil
        else
            already_queued[task_id] = true
        end
    end
    return already_queued
end

local function detect_time_skip()
    local ok, current_gt = pcall(function() return game.get_game_time() end)
    if not ok or not current_gt then return false end
    if _last_cycle_game_time then
        local ok2, diff_sec = pcall(function() return current_gt:diffSec(_last_cycle_game_time) end)
        if ok2 and diff_sec and diff_sec >= TIME_SKIP_GAME_SEC then
            _last_time_skip_global = time_global()
            _last_cycle_game_time = current_gt
            return true
        end
    end
    _last_cycle_game_time = current_gt
    return false
end

local function is_recent_time_skip()
    return _last_time_skip_global > 0
        and (time_global() - _last_time_skip_global) < TIME_SKIP_GRACE_MS
end

-- verdicts allowed to latch a permanent legit decision
local STRONG_LEGIT_REASONS = {
    "player_kill", "target_killed",
    "squad_member_kill", "squad_member_killed", "squad_sibling_killed",
    "target_hit_then_died", "target_dead_nearby_kill",
    "kills_at_location", "kills_nearby", "kills_by_type",
    "enemy_kills_at_location", "level_cleared",
}

-- reasons arrive with a task-type prefix ("bounty_player_kill"), so match
-- the bare reason as a whole suffix component
local function is_strong_legit_reason(reason)
    if not reason then return false end
    for i = 1, #STRONG_LEGIT_REASONS do
        local s = STRONG_LEGIT_REASONS[i]
        if reason == s or reason:sub(-(#s + 1)) == "_" .. s then
            return true
        end
    end
    return false
end

local function do_autocompletion()
    if not _mod_ready then return end

    cleanup_task_cache()

    _cycle_config = nil
    local cfg = get_cycle_config()

    if not cfg.enable then return end

    detect_time_skip()

    if cfg.pda_check then
        if not db.actor then return end
        local has_pda = false
        if fair_autocomplete_utils and fair_autocomplete_utils.has_pda then
            has_pda = fair_autocomplete_utils.has_pda(db.actor)
        else
            -- detect PDA by slot (8), robust to renamed PDAs (Fatal Error etc.)
            has_pda = (db.actor.item_in_slot and db.actor:item_in_slot(8)) and true or false
        end
        if not has_pda then return end

        -- Fatal Error compat: honor the equipped PDA's autocomplete ini flag.
        -- only acts when the key exists (FE installed); off by default.
        if cfg.respect_fe_pda_flag and db.actor.item_in_slot then
            local pda = db.actor:item_in_slot(8)
            if pda and ini_sys and ini_sys.line_exist
               and ini_sys:line_exist(pda:section(), "autocomplete")
               and ini_sys:r_bool_ex(pda:section(), "autocomplete") ~= true
            then
                return
            end
        end
    end

    local tm = task_manager.get_task_manager()
    if not tm or not tm.task_info then return end

    local now_ms = time_global()
    local delay_ms = math.max(0, math.floor((cfg.completion_delay or 5) * 1000))

    local already_queued = drain_pending_queues(tm, now_ms, cfg)

    for task_id, _ in pairs(_registered_tasks) do
        if not tm.task_info[task_id] or not is_task_in_progress(task_id) then
            _registered_tasks[task_id] = nil
            _task_compensation_prices[task_id] = nil
            _last_logged_stage[task_id] = nil
            _last_logged_verdict[task_id] = nil
            _last_logged_hunt[task_id] = nil
            _decided_legit[task_id] = nil
        end
    end

    for task_id, task_info in pairs(tm.task_info) do
        if task_id and task_info and not already_queued[task_id]
           and is_task_in_progress(task_id) then
            local stage = task_info.stage

            -- stage-change tracker: print whenever an in-progress task moves
            -- to a new stage. stage_complete is the stage FA fires at.
            if cfg.debug and stage and _last_logged_stage[task_id] ~= stage then
                _last_logged_stage[task_id] = stage
                -- fill the cache first so stage_complete reads its real value
                -- instead of nil on the task's first pass through this loop.
                local tc = get_task_def(task_id)
                local sc = tc and tc.stage_complete
                local tf = tc and tc.target_functor
                printf("[FA] Task %s: stage now %s (stage_complete=%s, functor=%s, type=%s, target=%s)",
                    tostring(task_id), tostring(stage), tostring(sc),
                    tostring(tf), tostring(get_task_type(tf, task_id)),
                    tostring(tc and tc.target))
            end

            if stage and stage >= 0 and stage <= 20 then
                local ok, err = pcall(function()
                    local should, reason = should_autocomplete(task_id, task_info)

                    -- task giver died: cancel without goodwill penalty (strip
                    -- on_fail) instead of Anomaly's natural penalized fail.
                    -- exempt keep-giver-alive task types (death = player fault).
                    -- giver_not_found rides the same route: a nil server object
                    -- for a once-valid giver id means the corpse got cleaned up
                    -- by alife; without this the task sits in abstain limbo
                    -- until the vanilla timeout.
                    if (not should) and (reason == "giver_dead" or reason == "giver_not_found")
                       and cfg.no_penalty_on_giver_death
                    then
                        local tc = get_task_def(task_id)
                        local tf = tc and tc.target_functor
                        local ttype = get_task_type(tf, task_id)
                        if not GIVER_DEATH_PENALTY_TYPES[ttype] then
                            reason = "giverdead_cancel"
                        end
                    end

                    -- level-proximity gate: too far from the giver to autocomplete.
                    -- abstain (uncertain_*), never cancel. whitelist bypasses.
                    if should and reason ~= "whitelisted"
                       and not location_allows_autocomplete(task_info)
                    then
                        should = false
                        reason = "uncertain_too_far"
                    end

                    -- alife-clean guard: weak-evidence autocompletes right
                    -- after sleep/fast-travel become stolen. see §8.
                    if should and reason and reason:find("assumed_")
                       and cfg.cancel_if_stolen and is_recent_time_skip()
                    then
                        should = false
                        reason = "stolen_alife_clean"
                    end

                    -- latch the FINAL verdict, not the raw validator return. a
                    -- task that survived the alife-clean guard with should==true
                    -- AND strong kill evidence is a confirmed legit completion:
                    -- never cancel it later even if its kill evidence ages out
                    -- weak verdicts (shot-proximity, assumed_*) do not latch
                    if should and is_strong_legit_reason(reason) then
                        _decided_legit[task_id] = true
                    end

                    if cfg.debug then
                        -- print only when the verdict changes, not every check cycle
                        local verdict = tostring(should) .. "|" .. tostring(reason)
                        if _last_logged_verdict[task_id] ~= verdict then
                            _last_logged_verdict[task_id] = verdict
                            printf("[FA] Task %s: should=%s, reason=%s",
                                tostring(task_id), tostring(should), tostring(reason))
                        end
                    end

                    if should then
                        if cfg.enable_autocomplete then
                            local target_functor = nil
                            if _task_cache[task_id] then
                                target_functor = _task_cache[task_id].target_functor
                            end
                            _recently_processed[task_id] = os.time()
                            -- mark for compensation NOW; if Anomaly's update tick
                            -- transitions the task naturally during our delay
                            -- window, the task_callback patch still applies.
                            _tasks_being_autocompleted[task_id] = true
                            if delay_ms > 0 then
                                _pending_completions[task_id] = {
                                    ready_at = now_ms + delay_ms,
                                    giver_id = task_info.task_giver_id,
                                    target_functor = target_functor,
                                }
                            else
                                fire_completion(tm, task_id, task_info.task_giver_id, target_functor)
                            end
                        end
                    elseif cfg.cancel_if_stolen and reason and reason:find("stolen_")
                           and not _decided_legit[task_id] then
                        _recently_processed[task_id] = os.time()

                        -- run the giver cleanup that on_fail would have done
                        -- before we strip it (entry still present here).
                        run_drx_giver_cleanup(task_id, task_info)

                        -- strip condlists so engine update() during delay can't
                        -- pay rewards. safe to mutate: ref is already-parsed.
                        if task_info then
                            task_info.on_complete = nil
                            task_info.on_fail = nil
                        end

                        if delay_ms > 0 then
                            _pending_cancellations[task_id] = {
                                ready_at = now_ms + delay_ms,
                                giver_id = task_info.task_giver_id,
                                reason = reason,
                            }
                        else
                            fire_cancellation(tm, task_id, task_info.task_giver_id, reason)
                        end
                    elseif reason == "giverdead_cancel" then
                        _recently_processed[task_id] = os.time()

                        -- run the giver cleanup that on_fail would have done
                        -- before we strip it (entry still present here).
                        run_drx_giver_cleanup(task_id, task_info)

                        -- strip condlists so the engine's natural fail during
                        -- the delay can't apply the on_fail goodwill penalty.
                        if task_info then
                            task_info.on_complete = nil
                            task_info.on_fail = nil
                        end

                        if delay_ms > 0 then
                            _pending_cancellations[task_id] = {
                                ready_at = now_ms + delay_ms,
                                giver_id = task_info.task_giver_id,
                                reason = "giverdead_cancel",
                            }
                        else
                            fire_cancellation(tm, task_id, task_info.task_giver_id, "giverdead_cancel")
                        end
                    end
                end)
                if not ok then
                    printf("![FA] Error checking task %s: %s", tostring(task_id), tostring(err))
                end
            end
        end
    end
end

-- ### INITIALIZATION

function actor_on_first_update()
    printf("[FA] actor_on_first_update - mod ready!")
    _mod_ready = true
    
    local interval = get_mcm_config(nil, "check_interval") or 2.0
    interval = math.max(0.5, tonumber(interval) or 2.0)
    
    CreateTimeEvent("fair_autocomplete", "main_loop", interval, function()
        pcall(do_autocompletion)
        local new_interval = get_mcm_config(nil, "check_interval") or 2.0
        new_interval = math.max(0.5, tonumber(new_interval) or 2.0)
        ResetTimeEvent("fair_autocomplete", "main_loop", new_interval)
        return false
    end)
end

function on_game_start()
    printf("[FA] on_game_start called")
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
end

function save_state(m_data)
    m_data.fa_registered_tasks = _registered_tasks

    -- persist pending queues with relative timing so they survive any session
    -- gap (player saves mid-delay, comes back days/months later).
    local now = time_global()
    local pc, px = {}, {}
    for tid, e in pairs(_pending_completions) do
        pc[tid] = {
            seconds_remaining = math.max(0, (e.ready_at - now) / 1000),
            giver_id = e.giver_id,
            target_functor = e.target_functor,
        }
    end
    for tid, e in pairs(_pending_cancellations) do
        px[tid] = {
            seconds_remaining = math.max(0, (e.ready_at - now) / 1000),
            giver_id = e.giver_id,
            reason = e.reason,
        }
    end
    m_data.fa_pending_completions = pc
    m_data.fa_pending_cancellations = px

    -- persist queue-time flag so save-during-delay still pays money comp on
    -- load. see DEV_STRATEGY.md invariant #2.
    local ta = {}
    for tid, v in pairs(_tasks_being_autocompleted) do
        if v then ta[tid] = true end
    end
    m_data.fa_tasks_being_autocompleted = ta

    -- persist the legit-verdict latch so a load-then-immediately-sleep can't
    -- reopen a task FA already judged as a player completion
    local dl = {}
    for tid, v in pairs(_decided_legit) do
        if v then dl[tid] = true end
    end
    m_data.fa_decided_legit = dl
end

function load_state(m_data)
    _task_cache = {}
    _task_cache_count = 0
    _registered_tasks = m_data.fa_registered_tasks or {}
    _recently_processed = {}
    -- fresh debug-dedup state per session: each task logs once after load
    _last_logged_stage = {}
    _last_logged_verdict = {}
    _last_logged_hunt = {}
    _task_compensation_prices = {}
    _tasks_being_autocompleted = {}
    _decided_legit = {}
    _utils = nil
    _kill_tracker = nil
    _cycle_config = nil

    -- restore pending queues, re-anchoring relative times to this session's clock
    _pending_completions = {}
    _pending_cancellations = {}
    local now = time_global()
    if m_data.fa_pending_completions then
        for tid, e in pairs(m_data.fa_pending_completions) do
            _pending_completions[tid] = {
                ready_at = now + (tonumber(e.seconds_remaining) or 0) * 1000,
                giver_id = e.giver_id,
                target_functor = e.target_functor,
            }
        end
    end
    if m_data.fa_pending_cancellations then
        for tid, e in pairs(m_data.fa_pending_cancellations) do
            _pending_cancellations[tid] = {
                ready_at = now + (tonumber(e.seconds_remaining) or 0) * 1000,
                giver_id = e.giver_id,
                reason = e.reason,
            }
        end
    end

    -- restore queue-time flags, see save_state above.
    if m_data.fa_tasks_being_autocompleted then
        for tid, v in pairs(m_data.fa_tasks_being_autocompleted) do
            if v then _tasks_being_autocompleted[tid] = true end
        end
    end

    -- restore the legit-verdict latch. normalize keys to numbers: m_data may
    -- return task ids as strings after a save/load round-trip, and the cancel
    -- guard indexes by the numeric task_id from tm.task_info
    if m_data.fa_decided_legit then
        for tid, v in pairs(m_data.fa_decided_legit) do
            if v then _decided_legit[tonumber(tid) or tid] = true end
        end
    end

    -- re-strip condlists for pending cancels; engine reloaded them from INI.
    local tm = task_manager.get_task_manager()
    if tm and tm.task_info then
        for tid, _ in pairs(_pending_cancellations) do
            local ti = tm.task_info[tid]
            if ti then
                ti.on_complete = nil
                ti.on_fail = nil
            end
        end
    end

    local current_time = os.time()
    for task_id, reg_data in pairs(_registered_tasks) do
        local rt = reg_data.registered_time
        if not rt or type(rt) ~= "number" or rt < 1000000000 then
            reg_data.registered_time = current_time
        end
    end
    
    _mod_ready = true
    
    -- recreate time event after load
    local interval = 2.0
    if fair_autocomplete_mcm and fair_autocomplete_mcm.get_config then
        interval = fair_autocomplete_mcm.get_config(nil, "check_interval") or 2.0
    end
    interval = math.max(0.5, tonumber(interval) or 2.0)
    
    RemoveTimeEvent("fair_autocomplete", "main_loop")
    CreateTimeEvent("fair_autocomplete", "main_loop", interval, function()
        pcall(do_autocompletion)
        local new_interval = 2.0
        if fair_autocomplete_mcm and fair_autocomplete_mcm.get_config then
            new_interval = fair_autocomplete_mcm.get_config(nil, "check_interval") or 2.0
        end
        new_interval = math.max(0.5, tonumber(new_interval) or 2.0)
        ResetTimeEvent("fair_autocomplete", "main_loop", new_interval)
        return false
    end)
end

-- ### MONKEYPATCHES

-- stop talking before squad removal (CTD prevention)
local _original_remove_squad = nil
if sim_board and sim_board.simulation_board and sim_board.simulation_board.remove_squad then
    _original_remove_squad = sim_board.simulation_board.remove_squad
    
    -- Override with safe version that stops dialog first
    sim_board.simulation_board.remove_squad = function(self, squad)
        -- Stop any ongoing dialog with squad members before removal
        if squad and fair_autocomplete_utils and fair_autocomplete_utils.stop_talk_squad then
            pcall(function()
                fair_autocomplete_utils.stop_talk_squad(squad)
            end)
        end
        
        return _original_remove_squad(self, squad)
    end
    
    printf("[FA] Monkeypatched sim_board.remove_squad for CTD prevention")
end

-- item compensation (replaces items with money for autocompleted tasks)
local _orig_task_callback = task_manager.task_callback
task_manager.task_callback = function(tsk, stage)
    local tsk_id = tsk:get_id()

    if not _tasks_being_autocompleted[tsk_id] then
        _orig_task_callback(tsk, stage)
        return
    end

    _tasks_being_autocompleted[tsk_id] = nil

    if not get_mcm_config(nil, "enable") or not get_mcm_config(nil, "compensate_item_rewards") then
        _orig_task_callback(tsk, stage)
        return
    end

    if stage ~= task.completed then
        _orig_task_callback(tsk, stage)
        return
    end

    local rtask = task_manager.get_task_manager().task_info[tsk_id]
    if not rtask or not rtask.on_complete or not rtask.on_complete[1] or not rtask.on_complete[1][3] then
        _orig_task_callback(tsk, stage)
        return
    end

    local compensation = _task_compensation_prices[tsk_id]
    if not compensation then
        compensation = calculate_task_compensation(rtask.on_complete[1][3])
        _task_compensation_prices[tsk_id] = compensation
    end

    if not compensation or not compensation.rewards then
        _orig_task_callback(tsk, stage)
        return
    end

    -- xr_logic.parse_condlist memoizes; condlists with identical INI strings
    -- share the same Lua table. Mutating in place would poison every other
    -- task that shares this condlist. Build a per-task copy and swap the ref.
    local original_on_complete = rtask.on_complete
    local cloned = {}
    for i = 1, #original_on_complete do
        if i == 1 then
            cloned[i] = {
                original_on_complete[i][1],  -- section name
                original_on_complete[i][2],  -- conditions (read-only here)
                compensation.rewards,        -- our money compensation
            }
        else
            cloned[i] = original_on_complete[i]
        end
    end
    rtask.on_complete = cloned

    local ok, err = pcall(_orig_task_callback, tsk, stage)
    if not ok then
        printf("![FA] task_callback error, restoring rewards: %s", tostring(err))
        rtask.on_complete = original_on_complete
        pcall(_orig_task_callback, tsk, stage)
    end
end
