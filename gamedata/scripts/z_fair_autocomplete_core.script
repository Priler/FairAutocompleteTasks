-- ### STATE

local _mod_ready = false
_task_cache = {}
_task_cache_count = 0  -- Track cache size
local _registered_tasks = {}
local _recently_processed = {}  -- Tasks recently completed/cancelled (prevent duplicates)
local _last_logged_stage = {}   -- task_id to last stage we printed, for stage-change logging
local _last_logged_verdict = {} -- task_id to last "should|reason" we printed, change-only debug
local _last_logged_hunt = {}    -- task_id to last hunt-counts line we printed, change-only debug
local _decided_legit = {}
_task_compensation_prices = {}  -- Cache for item reward compensation (GLOBAL for task_callback)
_tasks_being_autocompleted = {}

-- declared above should_autocomplete so the closure captures this local
local _cycle_config = nil

local _pending_completions = {}
local _pending_cancellations = {}

-- time-skip detection (sleep/fast-travel). see DEV_STRATEGY.md §8.
local _last_cycle_game_time = nil
local _last_time_skip_global = 0
local TIME_SKIP_GAME_SEC = 1800
local TIME_SKIP_GRACE_MS = 60000

-- module cache
local _utils = nil
local function get_utils()
    if not _utils then
        _utils = fair_autocomplete_utils
    end
    return _utils
end

local _kill_tracker = nil
local function get_kill_tracker()
    if not _kill_tracker then
        _kill_tracker = fair_autocomplete_kill_tracker
    end
    return _kill_tracker
end

-- engine-authoritative state check; 1 == eTaskStateInProgress
local function is_task_in_progress(task_id)
    if not db.actor or not db.actor.get_task_state then return false end
    local ok, state = pcall(function() return db.actor:get_task_state(task_id) end)
    return ok and state == 1
end

local function cleanup_task_cache()
    -- prune cache entries for tasks no longer in the task manager
    local tm = task_manager.get_task_manager()
    if tm and tm.task_info then
        for task_id in pairs(_task_cache) do
            if not tm.task_info[task_id] then
                _task_cache[task_id] = nil
                _task_cache_count = math.max(0, _task_cache_count - 1)
            end
        end
    end

    -- hard cap fallback (shouldn't trigger in practice after the prune above)
    if _task_cache_count > 500 then
        _task_cache = {}
        _task_cache_count = 0
    end

    local current_time = os.time()
    for task_id, processed_time in pairs(_recently_processed) do
        if current_time - processed_time > 60 then
            _recently_processed[task_id] = nil
        end
    end
end

