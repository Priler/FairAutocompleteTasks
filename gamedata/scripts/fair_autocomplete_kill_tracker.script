-- Fair Autocomplete - Kill Tracker
-- tracks kills by player and companions for task validation

_player_kills = {}
_player_hits = {}

-- proximity-credit fallback for kills with no attributable killer
_last_actor_shot_time = 0
_last_actor_shot_pos = nil

-- section to monster type mapping for inference
local SECTION_TO_MONSTER_TYPE = {
    ["boar"] = "monster_vegetarian",
    ["flesh"] = "monster_vegetarian",
    ["tushkano"] = "monster_vegetarian",
    ["tushkanchik"] = "monster_vegetarian",
    ["rat"] = "monster_vegetarian",
    
    ["dog"] = "monster_predatory",
    ["pseudodog"] = "monster_predatory",
    ["psy_dog"] = "monster_predatory",
    ["cat"] = "monster_predatory",
    ["chimera"] = "monster_predatory",
    ["lurker"] = "monster_predatory",
    
    ["zombie"] = "monster_zombied",
    ["snork"] = "monster_zombied",
    ["fracture"] = "monster_zombied",
    ["zombied"] = "monster_zombied",
    
    ["bloodsucker"] = "monster_special",
    ["controller"] = "monster_special",
    ["burer"] = "monster_special",
    ["poltergeist"] = "monster_special",
    ["pseudogiant"] = "monster_special",
    ["karlik"] = "monster_special",
    ["psysucker"] = "monster_special",
    ["gigant"] = "monster_special",
}

-- infer monster type from section name
local function infer_monster_type(section)
    if not section then return nil end
    
    -- try: section starts with monster type
    for prefix, monster_type in pairs(SECTION_TO_MONSTER_TYPE) do
        if string.find(section, prefix, 1, true) == 1 then
            return monster_type
        end
    end
    
    -- try: section contains monster type after underscore (e.g. "labx16_zombie_12")
    for prefix, monster_type in pairs(SECTION_TO_MONSTER_TYPE) do
        if string.find(section, "_" .. prefix, 1, true) then
            return monster_type
        end
    end
    
    return nil
end

-- ### UTILITY FUNCTIONS

local function get_mcm_config(category, key)
    if fair_autocomplete_mcm and fair_autocomplete_mcm.get_config then
        return fair_autocomplete_mcm.get_config(category, key)
    end
    return nil
end

local function dbg_printf(...)
    if not get_mcm_config(nil, "debug") then return end
    printf(...)
end

local function is_actor(obj)
    if not obj then return false end
    return obj:id() == AC_ID
end

local function is_companion(obj)
    if not obj then return false end
    
    local obj_id = obj:id()
    if obj_id == AC_ID then return false end
    
    local se_obj = alife_object(obj_id)
    if not se_obj then return false end
    
    if axr_companions and axr_companions.companion_squads then
        local squad_id = se_obj.group_id
        if squad_id and squad_id ~= 65535 and axr_companions.companion_squads[squad_id] then
            return true
        end
    end
    
    local game_obj = level.object_by_id(obj_id)
    if game_obj and game_obj.has_info then
        if game_obj:has_info("npcx_is_companion") then
            return true
        end
    end
    
    return false
end

local function se_obj_level_name(se_obj)
    if not se_obj or not se_obj.m_game_vertex_id then return nil end
    local gg = game_graph()
    if not gg then return nil end
    local al = alife()
    if not al then return nil end
    local v = gg:vertex(se_obj.m_game_vertex_id)
    if not v then return nil end
    return al:level_name(v:level_id())
end

local function get_object_smart_terrain(obj)
    if not obj then return nil end

    local se_obj = alife_object(obj:id())
    if not se_obj then return nil end

    -- squad linkage can be stale across levels; filter by victim's level
    local victim_level = se_obj_level_name(se_obj)

    local function smart_matches_level(smart)
        if not victim_level then return true end
        local lvl = se_obj_level_name(smart)
        if not lvl then return true end
        return lvl == victim_level
    end

    -- For NPCs in squads
    if se_obj.group_id and se_obj.group_id ~= 65535 then
        local squad = alife_object(se_obj.group_id)
        if squad then
            -- Try assigned_target_id first (where squad is going)
            if squad.assigned_target_id then
                local smart = alife_object(squad.assigned_target_id)
                if smart and smart.name and smart_matches_level(smart) then
                    return smart:name()
                end
            end
            -- Try current_target_id
            if squad.current_target_id then
                local smart = alife_object(squad.current_target_id)
                if smart and smart.name and smart_matches_level(smart) then
                    return smart:name()
                end
            end
        end
    end

    -- Fallback: try to get smart terrain from m_smart_terrain_id
    if se_obj.m_smart_terrain_id and se_obj.m_smart_terrain_id ~= 65535 then
        local smart = alife_object(se_obj.m_smart_terrain_id)
        if smart and smart.name and smart_matches_level(smart) then
            return smart:name()
        end
    end
    
    -- Fallback: find nearest smart terrain by position
    if simulation_objects and simulation_objects.get_nearest_smart then
        local nearest = simulation_objects.get_nearest_smart(se_obj)
        if nearest and nearest.name then
            return nearest:name()
        end
    end
    
    -- Fallback: iterate smart terrains and find closest
    if SIMBOARD and SIMBOARD.smarts then
        local obj_pos = obj:position()
        local closest_smart = nil
        local closest_dist = 150  -- max distance to associate with a smart
        
        for id, smart_data in pairs(SIMBOARD.smarts) do
            local smart = smart_data.smrt
            if smart and smart.position then
                local dist = obj_pos:distance_to(smart.position)
                if dist < closest_dist then
                    closest_dist = dist
                    closest_smart = smart:name()
                end
            end
        end
        
        if closest_smart then
            return closest_smart
        end
    end
    
    return nil
end

-- ### HIT RECORDING

function record_hit(victim, shooter)
    if not victim or not shooter then return end
    
    local victim_id = victim:id()
    local shooter_id = shooter:id()
    
    local is_player = is_actor(shooter)
    local is_comp = is_companion(shooter)
    
    if not is_player and not is_comp then
        return
    end
    
    if not _player_hits[victim_id] then
        _player_hits[victim_id] = {}
    end
    
    if not _player_hits[victim_id][shooter_id] then
        _player_hits[victim_id][shooter_id] = {
            is_player = is_player,
            is_companion = is_comp,
            hit_count = 1,
            first_hit_time = os.time()
        }
        dbg_printf("[FA-KillTracker] First hit recorded: victim=%s, shooter=%s, is_player=%s, is_companion=%s",
            victim_id, shooter_id, tostring(is_player), tostring(is_comp))
    else
        _player_hits[victim_id][shooter_id].hit_count = _player_hits[victim_id][shooter_id].hit_count + 1
    end
end

function npc_on_hit_callback(npc, amount, local_direction, who, bone_index)
    if not npc or not who then return end
    record_hit(npc, who)
end

function monster_on_hit_callback(monster, amount, local_direction, who, bone_index)
    if not monster or not who then return end
    record_hit(monster, who)
end

function was_hit_by_player_or_companion(victim_id)
    victim_id = tonumber(victim_id) or victim_id
    local hit_data = _player_hits[victim_id]
    if not hit_data then
        return false
    end
    
    local companion_kills_count = get_mcm_config(nil, "companion_kills_count")
    if companion_kills_count == nil then
        companion_kills_count = true
    end
    
    for shooter_id, data in pairs(hit_data) do
        if data.is_player then
            return true
        end
        if companion_kills_count and data.is_companion then
            return true
        end
    end
    
    return false
end

-- check who specifically had the assist - player or companion
local function get_assist_credit(victim_id)
    local hit_data = _player_hits[victim_id]
    if not hit_data then
        return false, false
    end
    
    local player_hit = false
    local companion_hit = false
    
    for shooter_id, data in pairs(hit_data) do
        if data.is_player then
            player_hit = true
        end
        if data.is_companion then
            companion_hit = true
        end
    end
    
    return player_hit, companion_hit
end

-- ### KILL RECORDING

function record_kill(victim, killer, is_monster)
    if not victim then return end
    
    local victim_id = victim:id()
    local killer_id = killer and killer:id() or nil
    
    local is_player = is_actor(killer)
    local is_comp = is_companion(killer)
    
    -- Check if player/companion hit first (assist credit)
    local has_assist = was_hit_by_player_or_companion(victim_id)
    
    if not is_player and not is_comp then
        if has_assist then
            local player_hit, companion_hit = get_assist_credit(victim_id)
            if player_hit then
                is_player = true
            elseif companion_hit then
                is_comp = true
            end
        elseif _last_actor_shot_time and _last_actor_shot_time > 0 then
            -- 10s/350m proximity credit
            local since_shot = time_global() - _last_actor_shot_time
            if since_shot >= 0 and since_shot <= 10000 then
                local shot_pos = _last_actor_shot_pos
                local vpos_ok, vpos = pcall(function() return victim:position() end)
                if shot_pos and vpos_ok and vpos then
                    local dx = shot_pos.x - vpos.x
                    local dy = shot_pos.y - vpos.y
                    local dz = shot_pos.z - vpos.z
                    if dx*dx + dy*dy + dz*dz <= 350 * 350 then
                        is_player = true
                    end
                end
            end
        end
        -- fall through: record as is_npc_kill for positive-theft evidence
    end

    local is_npc_kill = not is_player and not is_comp
    
    local smart_terrain = get_object_smart_terrain(victim)
    
    -- Get victim faction for defense task validation (stalkers)
    -- Get monster_type for mutant hunt validation (monsters)
    local victim_faction = nil
    local monster_type = nil
    
    local se_victim = alife_object(victim_id)
    if se_victim then
        if is_monster then
            if se_victim.group_id and se_victim.group_id ~= 65535 then
                local squad = alife_object(se_victim.group_id)
                if squad and squad.player_id then
                    monster_type = squad.player_id
                end
            end
            if not monster_type then
                monster_type = infer_monster_type(victim:section())
            end
        else
            if se_victim.community then
                victim_faction = se_victim:community()
            end
        end
    end
    
    -- store group_id now while server object still exists
    -- after death the se_obj may get destroyed, making squad lookups impossible
    local victim_group_id = nil
    if se_victim and se_victim.group_id and se_victim.group_id ~= 65535 then
        victim_group_id = se_victim.group_id
    end
    
    -- Store victim position for distance-based matching (as table for serialization)
    local victim_position = nil
    if victim.position then
        local pos = victim:position()
        victim_position = { x = pos.x, y = pos.y, z = pos.z }
    end
    
    -- Store actor position and distance at time of kill
    local actor_distance = nil
    local actor_level = nil
    local victim_level = nil
    
    if db.actor then
        if victim.position and db.actor.position then
            local victim_pos = victim:position()
            local actor_pos = db.actor:position()
            actor_distance = victim_pos:distance_to(actor_pos)
        end
        actor_level = level.name()
    end
    
    -- Get victim's level
    if se_victim then
        local gg = game_graph()
        if gg and se_victim.m_game_vertex_id then
            victim_level = alife():level_name(gg:vertex(se_victim.m_game_vertex_id):level_id())
        end
    end
    
    _player_kills[victim_id] = {
        killer_id = killer_id,
        time = os.time(),
        section = victim:section(),
        location = smart_terrain,
        position = victim_position,
        is_player_kill = is_player,
        is_companion_kill = is_comp,
        is_npc_kill = is_npc_kill,
        is_monster = is_monster or false,
        faction = victim_faction,
        monster_type = monster_type,
        actor_distance = actor_distance,
        actor_level = actor_level,
        victim_level = victim_level,
        group_id = victim_group_id,
    }
    
    if get_mcm_config(nil, "debug") then
        local dist_str = actor_distance and string.format("%.1f", actor_distance) or "nil"
        dbg_printf("[FA-KillTracker] Recorded kill: victim=%s, section=%s, smart=%s, by_player=%s, by_companion=%s, dist=%s",
            tostring(victim_id), victim:section(), smart_terrain or "unknown",
            tostring(is_player), tostring(is_comp), dist_str)
    end

    -- intentionally don't wipe _player_hits here; assist override needs it
end

function npc_on_death_callback(npc, who)
    record_kill(npc, who, false)
end

function actor_on_weapon_fired_callback(actor, weapon, ammo_count, grenade_ammo_count, ammo_type, target)
    _last_actor_shot_time = time_global()
    if db.actor and db.actor.position then
        local ok, pos = pcall(function() return db.actor:position() end)
        if ok and pos then
            _last_actor_shot_pos = { x = pos.x, y = pos.y, z = pos.z }
        end
    end
end

function monster_on_death_callback(monster, who)
    record_kill(monster, who, true)
end

-- ### KILL QUERY

function is_within_valid_distance(victim_id)
    local max_distance = get_mcm_config(nil, "max_kill_distance") or 0
    
    if max_distance == 0 then
        return true
    end
    
    local kill_data = _player_kills[victim_id]
    if not kill_data or not kill_data.actor_distance then
        return true
    end
    
    return kill_data.actor_distance <= max_distance
end

function is_same_level_kill(victim_id)
    local require_same_level = get_mcm_config(nil, "require_same_level")
    
    if not require_same_level then
        return true
    end
    
    local kill_data = _player_kills[victim_id]
    if not kill_data then
        return false
    end
    
    if not kill_data.actor_level or not kill_data.victim_level then
        return true
    end
    
    return kill_data.actor_level == kill_data.victim_level
end

function was_killed_by_player_or_companion(victim_id)
    -- normalize to number to handle string/number mismatch from save/load
    victim_id = tonumber(victim_id) or victim_id
    
    local kill_data = _player_kills[victim_id]
    
    if kill_data then
        local companion_kills_count = get_mcm_config(nil, "companion_kills_count")
        if companion_kills_count == nil then
            companion_kills_count = true
        end
        
        local killed_by_valid = false
        if kill_data.is_player_kill then
            killed_by_valid = true
        elseif companion_kills_count and kill_data.is_companion_kill then
            killed_by_valid = true
        end
        
        if killed_by_valid then
            if is_within_valid_distance(victim_id) and is_same_level_kill(victim_id) then
                return true
            else
                dbg_printf("[FA-KillTracker] Kill rejected: distance_ok=%s, same_level=%s",
                    tostring(is_within_valid_distance(victim_id)),
                    tostring(is_same_level_kill(victim_id)))
            end
        end
    end
    
    local count_assists = get_mcm_config(nil, "count_assists")
    if count_assists == nil then
        count_assists = true
    end
    
    if count_assists and was_hit_by_player_or_companion(victim_id) then
        dbg_printf("[FA-KillTracker] Kill counted via assist (hit before death)")
        return true
    end
    
    return false
end

function was_killed_by_player_only(victim_id)
    victim_id = tonumber(victim_id) or victim_id
    
    local kill_data = _player_kills[victim_id]
    if not kill_data then
        return false
    end
    
    if not kill_data.is_player_kill then
        return false
    end
    
    return is_within_valid_distance(victim_id) and is_same_level_kill(victim_id)
end

function get_kill_data(victim_id)
    victim_id = tonumber(victim_id) or victim_id
    return _player_kills[victim_id]
end

function get_hit_data(victim_id)
    victim_id = tonumber(victim_id) or victim_id
    return _player_hits[victim_id]
end

-- get the most recent player/companion kill within a time window
function get_most_recent_player_kill(max_age_seconds)
    max_age_seconds = max_age_seconds or 10
    local current_time = os.time()
    local best_kill = nil
    local best_time = 0
    local best_id = nil
    
    for victim_id, kill_data in pairs(_player_kills) do
        if (kill_data.is_player_kill or kill_data.is_companion_kill) and kill_data.time and type(kill_data.time) == "number" then
            local age = current_time - kill_data.time
            if age <= max_age_seconds and kill_data.time > best_time then
                best_time = kill_data.time
                best_kill = kill_data
                best_id = victim_id
            end
        end
    end
    
    return best_kill, best_id
end

-- check if target is dead (works for both online and offline NPCs)
function is_target_dead(target_id)
    target_id = tonumber(target_id) or target_id
    if not target_id then return false end
    
    local se_obj = alife_object(target_id)
    if not se_obj then
        return true
    end
    
    if se_obj.alive then
        local success, is_alive = pcall(function() return se_obj:alive() end)
        if success and not is_alive then
            return true
        end
    end
    
    return false
end

-- check if player killed any member of a squad
function was_squad_member_killed_by_player(squad_id)
    squad_id = tonumber(squad_id) or squad_id
    if not squad_id then return false end
    
    for victim_id, kill_data in pairs(_player_kills) do
        if kill_data.is_player_kill or kill_data.is_companion_kill then
            -- use stored group_id (alife object may already be destroyed after death)
            if kill_data.group_id and kill_data.group_id == squad_id then
                if is_within_valid_distance(victim_id) and is_same_level_kill(victim_id) then
                    return true, victim_id
                end
            end
        end
    end
    
    return false
end

-- ### PERSISTENCE

function save_state(m_data)
    m_data.fa_player_kills = _player_kills
    m_data.fa_player_hits = _player_hits
end

function load_state(m_data)
    _player_kills = m_data.fa_player_kills or {}
    _player_hits = m_data.fa_player_hits or {}

    -- normalize keys to numbers (pstor sometimes returns strings)
    local nk = {}
    for k, v in pairs(_player_kills) do nk[tonumber(k) or k] = v end
    _player_kills = nk

    local nh = {}
    for k, v in pairs(_player_hits) do nh[tonumber(k) or k] = v end
    _player_hits = nh

    _last_actor_shot_time = 0
    _last_actor_shot_pos = nil
end

-- ### CLEANUP

local DEFAULT_KILL_RETENTION = 1800
local CLEANUP_INTERVAL = 60
local MAX_KILL_RECORDS = 500
local MAX_HIT_RECORDS = 500

local function table_count(t)
    local n = 0
    for _ in pairs(t) do n = n + 1 end
    return n
end

local function evict_oldest(records, target_count, time_field)
    local entries = {}
    for k, v in pairs(records) do
        local t = nil
        if time_field then
            for _, sub in pairs(v) do
                if sub[time_field] and type(sub[time_field]) == "number" then
                    if not t or sub[time_field] < t then t = sub[time_field] end
                end
            end
        else
            t = v.time
        end
        entries[#entries + 1] = { key = k, t = t or 0 }
    end
    table.sort(entries, function(a, b) return a.t < b.t end)
    local to_remove = #entries - target_count
    for i = 1, to_remove do
        records[entries[i].key] = nil
    end
end

function cleanup_old_kills(max_age_seconds)
    max_age_seconds = max_age_seconds or DEFAULT_KILL_RETENTION

    local current_time = os.time()
    local removed_kills = 0
    local removed_hits = 0

    for victim_id, data in pairs(_player_kills) do
        local should_remove = false
        if not data.time or type(data.time) ~= "number" then
            should_remove = true
        elseif current_time - data.time > max_age_seconds then
            should_remove = true
        end
        if should_remove then
            _player_kills[victim_id] = nil
            removed_kills = removed_kills + 1
        end
    end

    for victim_id, hit_data in pairs(_player_hits) do
        local should_remove = false
        local oldest_hit_time = nil
        for _, data in pairs(hit_data) do
            if data.first_hit_time and type(data.first_hit_time) == "number" then
                if not oldest_hit_time or data.first_hit_time < oldest_hit_time then
                    oldest_hit_time = data.first_hit_time
                end
            end
        end
        if not oldest_hit_time then
            should_remove = true
        elseif current_time - oldest_hit_time > max_age_seconds then
            should_remove = true
        end
        if should_remove then
            _player_hits[victim_id] = nil
            removed_hits = removed_hits + 1
        end
    end

    local kill_count = table_count(_player_kills)
    if kill_count > MAX_KILL_RECORDS then
        evict_oldest(_player_kills, MAX_KILL_RECORDS, nil)
    end
    local hit_count = table_count(_player_hits)
    if hit_count > MAX_HIT_RECORDS then
        evict_oldest(_player_hits, MAX_HIT_RECORDS, "first_hit_time")
    end

    if removed_kills > 0 or removed_hits > 0 then
        dbg_printf("[FA-KillTracker] Cleanup done: kills_removed=%d, hits_removed=%d", removed_kills, removed_hits)
    end
end

-- ### INITIALIZATION

function on_game_start()
    RegisterScriptCallback("npc_on_death_callback", npc_on_death_callback)
    RegisterScriptCallback("monster_on_death_callback", monster_on_death_callback)
    RegisterScriptCallback("npc_on_hit_callback", npc_on_hit_callback)
    RegisterScriptCallback("monster_on_hit_callback", monster_on_hit_callback)
    RegisterScriptCallback("actor_on_weapon_fired", actor_on_weapon_fired_callback)
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)

    CreateTimeEvent("fa_kill_tracker", "cleanup", CLEANUP_INTERVAL, function()
        cleanup_old_kills(DEFAULT_KILL_RETENTION)
        ResetTimeEvent("fa_kill_tracker", "cleanup", CLEANUP_INTERVAL)
        return false
    end)
end
