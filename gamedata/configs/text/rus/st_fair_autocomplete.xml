<?xml version="1.0" encoding="windows-1251"?>
<string_table>

    <!-- MCM Menu Title -->
    <string id="ui_mcm_fair_autocomplete_title">
        <text>Честное Автозавершение</text>
    </string>
    
    <string id="ui_mcm_menu_fair_autocomplete">
        <text>Честное Автозавершение</text>
    </string>
    
    <!-- General Settings -->
    <string id="ui_mcm_fair_autocomplete_enable">
        <text>Включить мод</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_enable_desc">
        <text>Включает отслеживание убийств и мониторинг заданий. При отключении мод ничего не делает.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_enable_autocomplete">
        <text>Включить автозавершение</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_enable_autocomplete_desc">
        <text>Автоматически завершать задания когда вы убили цели. При отключении нужно идти к заказчику, но украденные задания всё равно отменяются.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_pda_check">
        <text>Проверка КПК</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_pda_check_desc">
        <text>Автозавершение работает только если у игрока есть КПК</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_require_player_kill">
        <text>Требовать убийства игроком/напарником</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_require_player_kill_desc">
        <text>Задания завершаются только если вы или ваши напарники убили цели</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_companion_kills_count">
        <text>Убийства напарников засчитываются</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_companion_kills_count_desc">
        <text>Убийства, совершённые вашими напарниками, засчитываются для выполнения задания</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_count_assists">
        <text>Засчитывать попадания</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_count_assists_desc">
        <text>Если вы или ваши напарники попали по цели до её смерти, засчитывать убийство даже если добил кто-то другой</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_max_kill_distance">
        <text>Макс. дистанция убийства (0=выкл)</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_max_kill_distance_desc">
        <text>Максимальная дистанция от игрока до цели в момент смерти. 0 = проверка отключена. По умолчанию: 0</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_require_same_level">
        <text>Требовать тот же уровень</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_require_same_level_desc">
        <text>Цель должна умереть на том же уровне, что и игрок, чтобы убийство засчиталось</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_cancel_if_stolen">
        <text>Отменять украденные задания</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_cancel_if_stolen_desc">
        <text>Отменять задания без штрафа, если кто-то другой убил вашу цель</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_check_interval">
        <text>Интервал проверки (секунды)</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_check_interval_desc">
        <text>Как часто проверять завершение заданий. Меньше = быстрее реакция, но чуть больше нагрузка на CPU</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_completion_delay">
        <text>Completion Delay (seconds)</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_completion_delay_desc">
        <text>Delay between detecting that a task is done and actually completing it. Adds an immersive pause where the task giver "processes" the result before sending the reward. Set to 0 to keep instant completion.</text>
    </string>

    
    <!-- Task Types Headers -->
    <string id="ui_mcm_fair_autocomplete_task_types_header">
        <text>--- Общие типы заданий ---</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_special_tasks_header">
        <text>--- Специальные задания ---</text>
    </string>
    
    <!-- General Task Types -->
    <string id="ui_mcm_fair_autocomplete_assault">
        <text>Штурм лагеря</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_assault_desc">
        <text>Уничтожить мутантов или враждебных сталкеров в локации</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_bounty">
        <text>Задания на убийство</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_bounty_desc">
